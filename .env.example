# Optional, authorized audio. This is the only browser-exposed setting.
VITE_WEDDING_MUSIC_URL=

# Server-only RSVP settings. Add these securely in Vercel; never use VITE_ prefixes.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY can be used instead of SUPABASE_SECRET_KEY.
RSVP_ALLOWED_ORIGIN=https://flois-and-age.vercel.app
RSVP_RATE_LIMIT_SECRET=

# Server-only organiser login: use a unique password of at least 16 characters.
WEDDING_ADMIN_PASSWORD=

# Local QA only. Never set on a deployment.
RSVP_QA_MODE=0
