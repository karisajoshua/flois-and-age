{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/invite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/rsvp.mjs": {
      "maxDuration": 30
    },
    "api/admin.mjs": {
      "maxDuration": 30
    },
    "api/photo.mjs": {
      "maxDuration": 30
    },
    "api/story.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
